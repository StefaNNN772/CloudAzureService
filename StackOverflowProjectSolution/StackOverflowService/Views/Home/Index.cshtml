@{
    ViewBag.Title = "Početna stranica";
}

<div class="jumbotron">
    <h1>StackOverflow aplikacija</h1>
    <p class="lead">Dobrodošli na StackOverflow aplikaciju! Ovde možete postavljati pitanja i odgovore iz oblasti programiranja.</p>
    <p>
        <a href="@Url.Action("Index", "Questions")" class="btn btn-primary btn-lg">
            <i class="fas fa-question-circle mr-2"></i>Pregledaj pitanja
        </a>
    </p>
</div>

<div class="row">
    <div class="col-md-4">
        <h2>Postavite pitanje</h2>
        <p>Imate problem sa kodom? Postavite pitanje i dobićete pomoć od zajednice.</p>
        <p>
            <a href="@Url.Action("Create", "Questions")" class="btn btn-outline-primary">
                <i class="fas fa-plus mr-2"></i>Novo pitanje
            </a>
        </p>
    </div>
    <div class="col-md-4">
        <h2>Odgovorite na pitanja</h2>
        <p>Pomozite drugima tako što ćete odgovoriti na njihova pitanja i deliti svoje znanje.</p>
        <p>
            <a href="@Url.Action("Index", "Questions")" class="btn btn-outline-primary">
                <i class="fas fa-comments mr-2"></i>Sva pitanja
            </a>
        </p>
    </div>
    <div class="col-md-4">
        <h2>Glasajte i zaradite reputaciju</h2>
        <p>Glasajte za dobre odgovore i zaradite reputaciju kada vaši odgovori budu prihvaćeni.</p>
        <p>
            <a href="@Url.Action("Index", "User")" class="btn btn-outline-primary">
                <i class="fas fa-user mr-2"></i>Moj profil
            </a>
        </p>
    </div>
</div>

<div class="alert alert-info mt-4">
    <h4>Informacije o sesiji</h4>
    <p>Session ID: @Session.SessionID</p>
    <p>Korisnik: @(Session["CurrentUser"] ?? "Nije prijavljen")</p>
</div>