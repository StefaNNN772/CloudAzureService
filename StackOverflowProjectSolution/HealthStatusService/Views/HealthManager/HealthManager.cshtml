@model List<DatabaseRepository.Models.HealthCheck>
@{
    ViewBag.Title = "Health Manager";

    var stackOverflowChecks = Model.Where(h => h.ServiceName == "StackOverflowService").OrderBy(h => h.Date).ToList();
    var notificationChecks = Model.Where(h => h.ServiceName == "NotificationService").OrderBy(h => h.Date).ToList();

    // Calculate availability percentages (assuming 3 hours = 180 minutes)
    var stackOverflowOkCount = stackOverflowChecks.Count(h => h.Status == "ok");
    var stackOverflowTotalCount = stackOverflowChecks.Count();
    var stackOverflowAvailability = stackOverflowTotalCount > 0 ? (double)stackOverflowOkCount / stackOverflowTotalCount * 100 : 0;

    var notificationOkCount = notificationChecks.Count(h => h.Status == "ok");
    var notificationTotalCount = notificationChecks.Count();
    var notificationAvailability = notificationTotalCount > 0 ? (double)notificationOkCount / notificationTotalCount * 100 : 0;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4><i class="fas fa-heartbeat mr-2"></i>Health Manager Dashboard</h4>
                </div>
                <div class="card-body">

                    <!-- Service Graphs Section -->
                    <div class="row mb-4">
                        <!-- StackOverflow Service Graph -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-info text-white">
                                    <h5><i class="fas fa-server mr-2"></i>StackOverflow Service</h5>
                                </div>
                                <div class="card-body">
                                    <canvas id="stackOverflowChart" width="400" height="200"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Notification Service Graph -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-warning text-white">
                                    <h5><i class="fas fa-bell mr-2"></i>Notification Service</h5>
                                </div>
                                <div class="card-body">
                                    <canvas id="notificationChart" width="400" height="200"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Availability Statistics -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card border-info">
                                <div class="card-body text-center">
                                    <h5 class="card-title">StackOverflow Service Availability</h5>
                                    <h2 class="text-info">@stackOverflowAvailability.ToString("F1")%</h2>
                                    <p class="card-text">
                                        <span class="text-success">@stackOverflowOkCount OK</span> /
                                        <span class="text-danger">@(stackOverflowTotalCount - stackOverflowOkCount) Failed</span>
                                        out of @stackOverflowTotalCount checks
                                    </p>
                                    <small class="text-muted">Over the last 3 hours</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border-warning">
                                <div class="card-body text-center">
                                    <h5 class="card-title">Notification Service Availability</h5>
                                    <h2 class="text-warning">@notificationAvailability.ToString("F1")%</h2>
                                    <p class="card-text">
                                        <span class="text-success">@notificationOkCount OK</span> /
                                        <span class="text-danger">@(notificationTotalCount - notificationOkCount) Failed</span>
                                        out of @notificationTotalCount checks
                                    </p>
                                    <small class="text-muted">Over the last 3 hours</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Status Table -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header bg-secondary text-white">
                                    <h5><i class="fas fa-list mr-2"></i>Recent Health Checks</h5>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover">
                                            <thead class="thead-dark">
                                                <tr>
                                                    <th>Service Name</th>
                                                    <th>Status</th>
                                                    <th>Date & Time</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    foreach (var check in Model.OrderByDescending(h => h.Date).Take(20))
                                                    {
                                                        <tr>
                                                            <td>
                                                                <i class="fas @(check.ServiceName == "StackOverflowService" ? "fa-server text-info" : "fa-bell text-warning") mr-2"></i>
                                                                @check.ServiceName
                                                            </td>
                                                            <td>
                                                                @if (check.Status == "ok")
                                                                {
                                                                    <span class="badge badge-success">
                                                                        <i class="fas fa-check mr-1"></i>OK
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge badge-danger">
                                                                        <i class="fas fa-times mr-1"></i>NOT OK
                                                                    </span>
                                                                }
                                                            </td>
                                                            <td>@check.Date.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="3" class="text-center text-muted">No recent health checks available</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card-header h4, .card-header h5 {
            margin-bottom: 0;
        }

        .table th {
            border-top: none;
        }

        .badge {
            font-size: 0.8em;
        }

        canvas {
            max-height: 300px;
        }

        .card-body h2 {
            font-weight: bold;
            margin: 10px 0;
        }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script>
        $(document).ready(function() {
            // StackOverflow Service Chart Data
            var stackOverflowData = [
                @Html.Raw(string.Join(",", stackOverflowChecks.Select(h => "'" + h.Date.ToString("HH:mm") + "'")))
            ];
            var stackOverflowStatus = [
                @Html.Raw(string.Join(",", stackOverflowChecks.Select(h => h.Status == "ok" ? "1" : "0")))
            ];

            // Notification Service Chart Data
            var notificationData = [
                @Html.Raw(string.Join(",", notificationChecks.Select(h => "'" + h.Date.ToString("HH:mm") + "'")))
            ];
            var notificationStatus = [
                @Html.Raw(string.Join(",", notificationChecks.Select(h => h.Status == "ok" ? "1" : "0")))
            ];

            // StackOverflow Service Chart
            var stackOverflowCtx = document.getElementById('stackOverflowChart').getContext('2d');
            var stackOverflowChart = new Chart(stackOverflowCtx, {
                type: 'line',
                data: {
                    labels: stackOverflowData,
                    datasets: [{
                        label: 'Service Status',
                        data: stackOverflowStatus,
                        backgroundColor: 'rgba(23, 162, 184, 0.2)',
                        borderColor: 'rgba(23, 162, 184, 1)',
                        borderWidth: 3,
                        fill: true,
                        stepped: true,
                        pointBackgroundColor: function(context) {
                            return context.parsed.y === 1 ? '#28a745' : '#dc3545';
                        },
                        pointBorderColor: function(context) {
                            return context.parsed.y === 1 ? '#28a745' : '#dc3545';
                        },
                        pointRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            display: false
                        },
                        title: {
                            display: true,
                            text: 'Service Health Over Time'
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 1,
                            ticks: {
                                stepSize: 1,
                                callback: function(value) {
                                    return value === 1 ? 'OK' : 'NOT OK';
                                }
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Time'
                            }
                        }
                    }
                }
            });

            // Notification Service Chart
            var notificationCtx = document.getElementById('notificationChart').getContext('2d');
            var notificationChart = new Chart(notificationCtx, {
                type: 'line',
                data: {
                    labels: notificationData,
                    datasets: [{
                        label: 'Service Status',
                        data: notificationStatus,
                        backgroundColor: 'rgba(255, 193, 7, 0.2)',
                        borderColor: 'rgba(255, 193, 7, 1)',
                        borderWidth: 3,
                        fill: true,
                        stepped: true,
                        pointBackgroundColor: function(context) {
                            return context.parsed.y === 1 ? '#28a745' : '#dc3545';
                        },
                        pointBorderColor: function(context) {
                            return context.parsed.y === 1 ? '#28a745' : '#dc3545';
                        },
                        pointRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            display: false
                        },
                        title: {
                            display: true,
                            text: 'Service Health Over Time'
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 1,
                            ticks: {
                                stepSize: 1,
                                callback: function(value) {
                                    return value === 1 ? 'OK' : 'NOT OK';
                                }
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Time'
                            }
                        }
                    }
                }
            });
        });
    </script>
}